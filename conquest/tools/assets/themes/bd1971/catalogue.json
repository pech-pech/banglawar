{
 "schema": "asset-catalogue/1",
 "theme": "bd1971",
 "_note": "Maps the Blender pilot's output folders to theme-neutral role ids. Pilot piece names (meadow, hq, hospital...) appear ONLY here and in file names; the pipeline and the game see role ids (tile.meadow, bld.core, bld.scout_post...). The structure-to-role mapping follows 05-theme-pack-spec section 2.3 and 19-blender-pilot-plan (hospital = bld.scout_post, shelter = bld.habitat, granary = bld.food, landing = bld.port, hq = bld.core). Roots are given on the command line (--root pilot=<bd1971-pilot/out>).",
 "tile_px": 256,
 "projection": {"kind": "iso_2_1", "tile_w": 256, "tile_h": 128},
 "roots": ["pilot"],
 "layers": [
  {"id": "ground", "order": 0, "sorting": "fixed", "tiebreak": 0},
  {"id": "terrain", "order": 10, "sorting": "depth", "tiebreak": 0},
  {"id": "prop", "order": 15, "sorting": "depth", "tiebreak": 1},
  {"id": "structure", "order": 20, "sorting": "depth", "tiebreak": 2},
  {"id": "unit", "order": 30, "sorting": "depth", "tiebreak": 3},
  {"id": "fx", "order": 40, "sorting": "fixed", "tiebreak": 0},
  {"id": "overlay", "order": 50, "sorting": "fixed", "tiebreak": 0}
 ],
